<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net481;net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Description>STUN messages written in C#: their attributes, MESSAGE-INTEGRITY and FINGERPRINT, and the keys of STUN's credentials, of a client and a server alike.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpStunClient" />
    <InternalsVisibleTo Include="SharpStunServer" />
    <InternalsVisibleTo Include="SharpTurnServer" />
    <InternalsVisibleTo Include="SharpICE" />
    <InternalsVisibleTo Include="SharpICE.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' OR '$(TargetFramework)' == 'net481'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

	<!-- the public API: listed in PublicAPI.*.txt, and checked against the last release (doc/public-api.md) -->
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
	</ItemGroup>

	<PropertyGroup>
		<WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
		<!-- overloads with optional parameters are a style choice here, not a break -->
		<NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
		<EnablePackageValidation>true</EnablePackageValidation>
		<!-- no baseline until this library has a published version; still checks its target frameworks agree -->
	</PropertyGroup>

</Project>
