<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net481;net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Description>A TURN server written in C#: over UDP, TCP, TLS and DTLS, relaying UDP.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpStunServer\SharpStunServer.csproj" />
    <ProjectReference Include="..\SharpTurnCommon\SharpTurnCommon.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' OR '$(TargetFramework)' == 'net481'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

	<!-- the public API: listed in PublicAPI.*.txt, and checked against the last release (doc/public-api.md) -->
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
	</ItemGroup>

	<PropertyGroup>
		<!-- a symbol gone from the API fails the build; one added warns, until listed: an addition breaks no one -->
		<WarningsAsErrors>$(WarningsAsErrors);RS0017</WarningsAsErrors>
		<!-- overloads with optional parameters are a style choice here, not a break -->
		<NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
		<EnablePackageValidation>true</EnablePackageValidation>
		<!-- no baseline until this library has a published version; still checks its target frameworks agree -->
	</PropertyGroup>

</Project>
